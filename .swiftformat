--minversion 0.64.0
--exclude .build,DerivedData,Skills,Sources/CLibxml2,Sources/CDnssd,IntegrationTests/.build,Sources/DuckoXMPP/Stanzas/Normalization/UnicodeTables.generated.swift

# Format options
--closurevoid preserve
--commas inline
--importgrouping testable-bottom
--self init-only
--stripunusedargs closure-only
--swiftversion 6.2

# Rules
--enable isEmpty
--disable redundantReturn,trailingClosures,wrapIfExpressionBodies,wrapIfStatementBodies,wrapMultilineStatementBraces
