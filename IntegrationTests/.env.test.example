# XEP-0480 SASL upgrade test: an account on a server that offers UPGR-SCRAM-SHA-256
# while the account holds only a SCRAM-SHA-1 credential. The test first runs the reset
# command, which must remove the account's SCRAM-SHA-256 credential so the server
# offers the upgrade again. Skipped while any of these is empty or unset.
export DUCKO_TEST_SASL_UPGRADE_JID="alice@your-upgrade-server.example"
export DUCKO_TEST_SASL_UPGRADE_PASSWORD=""
export DUCKO_TEST_SASL_UPGRADE_PORT="5222"
export DUCKO_TEST_SASL_UPGRADE_RESET_COMMAND=""

