<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <Project xmlns="http://usefulinc.com/ns/doap#"
             xmlns:foaf="http://xmlns.com/foaf/0.1/"
             xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#"
             xmlns:schema="https://schema.org/">
        <name>Ducko</name>

        <shortdesc xml:lang="en">A modern macOS XMPP client – spiritual successor to Adium.</shortdesc>
        <description xml:lang="en">Ducko is a modern, open-source XMPP client for the Mac. Instant messaging with Adium's soul.</description>

        <homepage rdf:resource="https://ducko.im"/>
        <download-page rdf:resource="https://github.com/ducko-im/ducko/releases"/>
        <bug-database rdf:resource="https://github.com/ducko-im/ducko/issues"/>

        <license rdf:resource="https://github.com/ducko-im/ducko/blob/main/LICENSE"/>
        <language>en</language>

        <schema:logo rdf:resource="https://raw.githubusercontent.com/ducko-im/ducko/main/AppIcon.png"/>

        <programming-language>Swift</programming-language>
        <os>macOS</os>

        <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-xmpp"/>
        <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-jabber"/>
        <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-client"/>

        <maintainer>
            <foaf:Person>
                <foaf:name>Tobias Hagemann</foaf:name>
                <foaf:homepage rdf:resource="https://tobiha.de"/>
            </foaf:Person>
        </maintainer>

        <repository>
            <GitRepository>
                <location rdf:resource="https://github.com/ducko-im/ducko.git"/>
                <browse rdf:resource="https://github.com/ducko-im/ducko"/>
            </GitRepository>
        </repository>

        <implements rdf:resource="https://xmpp.org/rfcs/rfc6120.html"/>
        <implements rdf:resource="https://xmpp.org/rfcs/rfc6121.html"/>
        <!-- RFC 5929: only the tls-server-end-point channel binding (section 4), not tls-unique -->
        <implements rdf:resource="https://www.rfc-editor.org/rfc/rfc5929"/>
        <implements rdf:resource="https://www.rfc-editor.org/rfc/rfc7590"/>
        <implements rdf:resource="https://www.rfc-editor.org/rfc/rfc7622"/>
        <implements rdf:resource="https://www.rfc-editor.org/rfc/rfc9266"/>

        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0004.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0030.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0045.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">No warning when a room's configuration later changes to logged or non-anonymous (status codes 170 and 172). No voice requests, room registration, or sending of mediated invitations</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0047.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">IQ stanzas only, used as the Jingle In-Band Bytestreams transport (XEP-0261)</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0054.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0059.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Used for MAM and channel search paging</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0060.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Only the subset PEP needs: publishing with publish-options and reconfiguring a node when they do not match, retrieving and retracting items, and notifications</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0065.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Proxy discovery, activation and SOCKS5 connections for Jingle (XEP-0260) only; no standalone bytestream negotiation</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0066.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0077.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0082.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0084.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">An avatar hosted at a web address does not show, because Ducko requests it from the publisher's avatar data node instead of the web address</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0085.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0115.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0153.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0157.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0158.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Ducko answers CAPTCHAs only in registration forms: images sent with the form, text questions, and the SHA-256 proof of work up to five hex digits. On a form that requires only the image and the proof of work, the proof of work is answered in place of the image. An image hosted on the web opens in the browser. Challenges sent with a message or a room join are not answered, and audio and video challenges are not played</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0163.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0166.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">File transfer sessions only</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0184.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0191.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0198.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0199.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0203.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0221.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Media is read in every form but shown only as images on CAPTCHA challenges in registration forms</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0223.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0231.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Ducko reads data sent inline in registration form replies. It does not ask for data it lacks, and holds none of its own to serve</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0234.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Offered files only, one per session; no file requests and no ranged transfers, so an interrupted transfer starts over</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0237.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0245.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0249.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0260.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">The receiving side offers no candidates of its own</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0261.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Offered only as the fallback from SOCKS5 Bytestreams</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0280.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0297.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0300.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0308.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">In group chats and their private chats, the user's own corrections are accepted across a nickname change by authenticated identity rather than by the original full JID</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0313.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0333.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">In group chats and their private chats, a received marker is matched by the message's own id rather than the stanza id the group chat assigned</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0334.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Only the store hint is sent</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0352.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0359.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0363.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0368.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0380.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0384.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Room member lists are fetched before each encrypted message rather than on join, and affiliation changes are not tracked. A request for unencrypted messages from a device that is not trusted is ignored. Trust On First Use is on by default, so messages are encrypted to a contact's new device without asking</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0386.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0388.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">SASL2 is used only when the server also offers Bind 2. The only further sign-in task supported is the XEP-0480 SCRAM upgrade, so a sign-in fails when the server asks for another, such as a second factor. A SASL2 or Bind 2 offer removed in transit leads to the SASL1 sign-in</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0390.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Ducko's own identity names its stream's xml:lang, which its hashes cover. A received identity without one inherits the disco#info query's, else the IQ's, else the stream header's</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0392.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0393.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0398.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0402.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0410.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0420.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Message stanzas only, used with OMEMO (XEP-0384)</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0421.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0424.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">In non-anonymous group chats, the user's own retractions are accepted across a nickname change by authenticated identity rather than by the original full JID</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0425.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0426.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0428.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0433.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0440.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Supports tls-exporter (TLS 1.3 only) and tls-server-end-point, and prefers tls-exporter. tls-unique is not supported. Sign-in is refused when -PLUS is offered but no listed type can be used on the connection. Over SASL1, -PLUS offered without types binds with tls-server-end-point</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0461.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0474.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Ducko does not apply the section 7 relaxation of XEP-0440 rule 6, so a matching hash never allows an unbound sign-in. The hash shows only that the offer arrived unchanged. An interceptor holding a trusted certificate can still pick a TLS version on which the listed binding type cannot be computed, such as TLS 1.2 for tls-exporter, and then relay the unbound sign-in</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0480.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Ducko requests one upgrade per sign-in, to the strongest offered SCRAM hash that is stronger than the one it signs in with. Because the returned hash is password-equivalent, it asks only on sign-ins bound to the TLS channel, and answers the task only after the server has proved it knows the password</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0515.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
    </Project>
</rdf:RDF>
