<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
    <Project xmlns="http://usefulinc.com/ns/doap#"
             xmlns:foaf="http://xmlns.com/foaf/0.1/"
             xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#"
             xmlns:schema="https://schema.org/">
        <name>Ducko</name>

        <shortdesc xml:lang="en">A modern macOS XMPP client – spiritual successor to Adium.</shortdesc>
        <description xml:lang="en">Ducko is a modern, open-source XMPP client for the Mac. Instant messaging with Adium's soul.</description>

        <homepage rdf:resource="https://ducko.im"/>
        <download-page rdf:resource="https://github.com/ducko-im/ducko/releases"/>
        <bug-database rdf:resource="https://github.com/ducko-im/ducko/issues"/>

        <license rdf:resource="https://github.com/ducko-im/ducko/blob/main/LICENSE"/>
        <language>en</language>

        <schema:logo rdf:resource="https://raw.githubusercontent.com/ducko-im/ducko/main/AppIcon.png"/>

        <programming-language>Swift</programming-language>
        <os>macOS</os>

        <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-xmpp"/>
        <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-jabber"/>
        <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-client"/>

        <maintainer>
            <foaf:Person>
                <foaf:name>Tobias Hagemann</foaf:name>
                <foaf:homepage rdf:resource="https://tobiha.de"/>
            </foaf:Person>
        </maintainer>

        <repository>
            <GitRepository>
                <location rdf:resource="https://github.com/ducko-im/ducko.git"/>
                <browse rdf:resource="https://github.com/ducko-im/ducko"/>
            </GitRepository>
        </repository>

        <implements rdf:resource="https://xmpp.org/rfcs/rfc6120.html"/>
        <implements rdf:resource="https://xmpp.org/rfcs/rfc6121.html"/>
        <implements rdf:resource="https://www.rfc-editor.org/rfc/rfc7590"/>
        <implements rdf:resource="https://www.rfc-editor.org/rfc/rfc7622"/>

        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0004.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0030.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0045.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">No voice requests, room registration or mediated invitations</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0047.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">IQ stanzas only, used as the Jingle In-Band Bytestreams transport (XEP-0261)</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0054.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0059.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Used for MAM paging</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0060.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Only the subset PEP needs: publishing with publish-options, retrieving and retracting items, and notifications</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0065.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Proxy discovery, activation and SOCKS5 connections for Jingle (XEP-0260) only; no standalone bytestream negotiation</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0066.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0077.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0084.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">An avatar hosted at a web address does not show, because Ducko requests it from the publisher's avatar data node instead of the web address</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0085.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0115.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0153.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0157.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0163.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0166.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">File transfer sessions only</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0184.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0191.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0198.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0199.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0203.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0223.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0234.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Offered files only, one per session; no file requests and no ranged transfers, so an interrupted transfer starts over</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0237.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0245.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0249.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0260.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">The receiving side offers no candidates of its own</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0261.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Offered only as the fallback from SOCKS5 Bytestreams</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0280.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0297.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0300.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Advertises SHA-256, which file checksums are verified with; Entity Capabilities 2.0 also uses SHA-512</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0308.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">In group chats and their private chats, a correction is accepted from whoever now holds the author's nickname, even after the author left, since occupant ids are not checked</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0313.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Ids the server stamps on messages are treated as archive ids without checking that it announces urn:xmpp:mam:2</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0333.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0334.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Only the store hint is sent</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0352.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0359.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0363.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0368.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0380.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0384.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">No session reset or opt-out handling, and encrypted messages fetched from the archive are not decrypted. This device is not re-added when removed from its own device list, room members' device lists are not fetched before sending, and devices that left a list still receive keys. Existing nodes with other settings are not reconfigured, and a new device id is not checked for collisions. A key exchange with a new identity key replaces the session without a trust decision</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0386.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0388.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">XEP-0440, which this requires, is only partially supported. SASL2 is used only when the server also offers Bind 2, and further sign-in tasks such as a second factor are not supported. A SASL2 offer removed in transit leads to the SASL1 sign-in</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0390.html"/>
                <xmpp:status>complete</xmpp:status>
                <xmpp:note xml:lang="en">Ducko's own identity names its stream's xml:lang, which its hashes cover. A received identity without one inherits the disco#info query's, else the IQ's, else the stream header's</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0392.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0393.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0398.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0402.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0410.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0420.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Used with OMEMO only, so the gaps the XEP-0384 entry lists apply here too</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0424.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">In group chats and their private chats, a retraction is accepted from whoever now holds the author's nickname, even after the author left, since occupant ids are not checked</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0425.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0428.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0433.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0440.html"/>
                <xmpp:status>partial</xmpp:status>
                <xmpp:note xml:lang="en">Only tls-server-end-point is supported, not tls-exporter. Against rules 5 and 6, sign-in proceeds unbound with the GS2 flag "n" when the server lists channel-binding types but offers no -PLUS mechanism, or lists only types Ducko cannot compute. It does the same when -PLUS is offered over SASL1 without types. An attacker holding a trusted certificate for the server can therefore switch binding off. Separately, after a verified SCRAM sign-in an account refuses a later offer of only PLAIN until the user resets this</xmpp:note>
            </xmpp:SupportedXep>
        </implements>
        <implements>
            <xmpp:SupportedXep>
                <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0461.html"/>
                <xmpp:status>complete</xmpp:status>
            </xmpp:SupportedXep>
        </implements>

